# このファイルを「config.env」という名前でコピーして、必要な行だけ書き換えてください。
# （config.env が無くても起動できます）

# 使うポート番号（ブラウザで http://localhost:3000 を開く）
PORT=3000

# アクセス用パスワード（空欄なら無し）。設定すると、開くときにパスワードを聞かれます。
# ユーザー名は何でもかまいません。
APP_PASSWORD=
# ※「設定」→「ユーザー」でユーザーを作ると、ユーザー別のログインに切り替わり、APP_PASSWORD は使われなくなります。

# HTTPS（暗号化）で起動する場合の証明書と秘密鍵（PEM形式のファイルの場所）。両方そろったときだけHTTPSになります。
# インターネットに公開する場合は必ず設定してください（docs/architecture.md の「認証と配布」）。
TLS_CERT_FILE=
TLS_KEY_FILE=

# Keepa API のキー（Amazon中古価格・定価の自動取得。空欄なら無効）
KEEPA_API_KEY=

# 初回起動時に架空のデモデータを入れるか（入れない場合は 0）
SEED_DEMO=1
